{
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(//**/.env.local)",
      "Read(**/.env.development)",
      "Read(//**/.env.development)",
      "Read(**/.env.production)",
      "Read(//**/.env.production)",
      "Read(**/.env.staging)",
      "Read(//**/.env.staging)",
      "Read(**/.env.test)",
      "Read(//**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(//**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/projects/**/*.jsonl)",
      "Read(~/.claude/history.jsonl)",
      "Read(**/.npmrc)",
      "Read(//**/.npmrc)",
      "Read(**/.netrc)",
      "Read(//**/.netrc)",
      "Read(**/.pypirc)",
      "Read(//**/.pypirc)",
      "Read(**/*.pem)",
      "Read(//**/*.pem)",
      "Read(**/*.key)",
      "Read(//**/*.key)",
      "Read(**/id_rsa*)",
      "Read(//**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(//**/id_ed25519*)",
      "Edit(**/.env)",
      "Edit(//**/.env)",
      "Edit(**/.env.local)",
      "Edit(//**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(//**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(//**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(//**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(//**/.env.test)",
      "Edit(**/.env.*.local)",
      "Edit(//**/.env.*.local)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.claude/projects/**/*.jsonl)",
      "Edit(~/.claude/history.jsonl)",
      "Edit(**/.npmrc)",
      "Edit(//**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(//**/.netrc)",
      "Edit(**/.pypirc)",
      "Edit(//**/.pypirc)",
      "Edit(**/*.pem)",
      "Edit(//**/*.pem)",
      "Edit(**/*.key)",
      "Edit(//**/*.key)",
      "Edit(**/id_rsa*)",
      "Edit(//**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(//**/id_ed25519*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.npmrc",
        "~/.netrc",
        "~/.claude/history.jsonl"
      ]
    }
  }
}